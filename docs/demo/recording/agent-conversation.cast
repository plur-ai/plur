[1.810, "o", "\r\n\u001b[1m\u001b[38;5;114m┃ Assistant\u001b[0m\r\n"]
[0.001, "o", "\u001b[38;5;114m┃\u001b[0m That is W3C PROV in JSON-LD, with the licence expressed as an ODRL\r\n"]
[0.000, "o", "\u001b[38;5;114m┃\u001b[0m policy. It stands on its own — no supporting log needed — and it has\r\n"]
[0.000, "o", "\u001b[38;5;114m┃\u001b[0m been checked against two implementations that share none of our code.\r\n"]
[0.000, "o", "\u001b[38;5;114m┃\u001b[0m \r\n"]
[0.000, "o", "\u001b[38;5;114m┃\u001b[0m One thing to tell them plainly: none of this is signed. It records what\r\n"]
[0.000, "o", "\u001b[38;5;114m┃\u001b[0m happened; it does not prove who wrote it.\r\n"]
[2.212, "o", "\r\n\u001b[1m\u001b[38;5;114mThe throwaway store is deleted on exit.\u001b[0m\r\n\r\n"]
