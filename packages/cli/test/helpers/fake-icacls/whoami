#!/bin/sh
# Fake `whoami /user /fo csv /nh` for the spawned-CLI Windows stub (see icacls
# in this folder): the current account and its SID.
[ "$1" = "/user" ] || exit 1
if [ -n "$USERDOMAIN" ]; then acct="$USERDOMAIN\\$USERNAME"; else acct="$USERNAME"; fi
printf '"%s","S-1-5-21-1111-2222-3333-1001"\r\n' "$acct"
