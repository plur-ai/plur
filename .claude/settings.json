{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/gregor/.plur/bin/plur-hook hook-inject",
            "timeout": 90,
            "async": true
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "auto|manual",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/gregor/.plur/bin/plur-hook hook-inject --rehydrate",
            "timeout": 90,
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "EnterPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/gregor/.plur/bin/plur-hook hook-inject --event plan_mode",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/gregor/.plur/bin/plur-hook hook-inject --event skill",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/gregor/.plur/bin/plur-hook hook-inject --event agent",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/gregor/.plur/bin/plur-hook hook-observe",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/gregor/.plur/bin/plur-hook hook-observe --post",
            "timeout": 3
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/gregor/.plur/bin/plur-hook hook-inject --event subagent",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/gregor/.plur/bin/plur-hook hook-learn-check",
            "timeout": 2
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "plur": {
      "command": "/Users/gregor/.plur/bin/plur-mcp",
      "args": []
    }
  }
}
