{
  // Typecheck the test suites.
  //
  // The build does not cover them: `tsup` emits declarations for `src` only, and
  // esbuild strips types without checking them, so nothing has ever read the
  // types in `packages/*/test`. That is roughly a third of the repo compiling
  // against types no tool verifies.
  //
  // It matters most exactly when the API changes shape. The async flip turned
  // ~20 store and engine methods into promise-returning ones; every test that
  // forgot an `await` still transpiles, still runs, and still passes — it just
  // asserts on a pending Promise instead of a value, which is true of almost
  // any assertion you can write about an object. A suite in that state reports
  // success for having checked nothing.
  //
  // `noEmit`, so this is a check and never a build input.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "rootDir": ".",
    "types": ["node", "vitest/globals"],
    // Test files legitimately reach into fixtures and helpers by relative path
    // across package boundaries; resolve them the way vitest does.
    "moduleResolution": "bundler",
    "allowJs": false
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "scripts/**/*.ts",
    "benchmark/**/*.ts"
  ],
  "exclude": ["**/dist/**", "**/node_modules/**"]
}
