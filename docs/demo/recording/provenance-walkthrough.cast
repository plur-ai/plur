{"version":3,"term":{"cols":80,"rows":24},"timestamp":1787502518,"command":"bash docs/demo/provenance-walkthrough.sh","env":{"SHELL":"/bin/zsh"}}
[0.016, "o", "\u001b[H\u001b[2J\u001b[3J"]
[0.000, "o", "\u001b[1m\u001b[36mRecording where a memory came from\u001b[0m\r\n\u001b[2mA throwaway store in /var/folders/ky/ms6htv7j6sv5q43hw0gt0bbm0000gn/T/tmp.afmJpB3kks — your own memories are untouched.\u001b[0m\r\n"]
[2.015, "o", "\r\n\u001b[1m\u001b[36m1. An ordinary memory, recorded the way most people start\u001b[0m\r\n──────────────────────────────────────────────────────────────\r\n"]
[0.809, "o", "\r\n\u001b[2m# No extra flags. Just the thing you learned.\u001b[0m\r\n"]
[1.209, "o", "\u001b[32m$ node /Users/crtah/Data/3-plur/2-projects/plur/packages/cli/dist/index.js learn 'Migrations run before deploys, never after' --path /var/folders/ky/ms6htv7j6sv5q43hw0gt0bbm0000gn/T/tmp.afmJpB3kks/store --json\u001b[0m\r\n"]
[0.680, "o", "{\"id\":\"ENG-2026-08-23-001\",\"statement\":\"Migrations run before deploys, never after\",\"scope\":\"global\",\"type\":\"behavioral\",\"domain\":null}\r\n"]
[1.407, "o", "\r\n\u001b[2m# Now ask where it came from. This is the whole feature in one command.\u001b[0m\r\n"]
[1.208, "o", "\u001b[32m$ node /Users/crtah/Data/3-plur/2-projects/plur/packages/cli/dist/index.js provenance 'migrations deploys' --path /var/folders/ky/ms6htv7j6sv5q43hw0gt0bbm0000gn/T/tmp.afmJpB3kks/store --json | python3 -m json.tool\u001b[0m\r\n"]
[0.695, "o", "{\r\n    \"found\": true,\r\n    \"engram_id\": \"ENG-2026-08-23-001\",\r\n    \"may_leave_this_machine\": false,\r\n    \"may_reuse_commercially\": true,\r\n    \"may_redistribute\": false,\r\n    \"licence_recognised\": true,\r\n    \"licence_chosen\": false,\r\n    \"scope\": \"global\",\r\n    \"visibility\": \"private\",\r\n    "]
[0.000, "o", "\"first_written\": \"2026-08-23T16:28:42.754Z\",\r\n    \"licence\": {\r\n        \"name\": \"cc-by-sa-4.0\",\r\n        \"chosen\": false,\r\n        "]
[0.000, "o", "\"meaning\": \"reuse allowed, credit required, share alike\"\r\n    },\r\n    \"recorded_steps\": 1,\r\n    \"not_recorded\": [\r\n        \"who asserted it\""]
[0.000, "o", ",\r\n        \"what kind of claim it is \\u2014 whether a person stated it or a model worked it out\""]
[0.000, "o", ",\r\n        \"what it came from\""]
[0.000, "o", ",\r\n        \"a licence was never chosen; the default above applies\"\r\n    "]
[0.000, "o", "],\r\n    \"complete\": false\r\n}\r\n"]
[1.409, "o", "\r\n\u001b[2m# Read the 'not_recorded' list. Those four things are genuinely unknown —\u001b[0m\r\n"]
[1.205, "o", "\r\n\u001b[2m# nobody wrote them down. The tool says so rather than leaving a blank,\u001b[0m\r\n"]
[1.207, "o", "\r\n\u001b[2m# because a blank reads as zero and 'unknown' does not.\u001b[0m\r\n"]
[1.212, "o", "\r\n\u001b[1m\u001b[36m2. The same memory, recorded properly\u001b[0m\r\n──────────────────────────────────────────────────────────────\r\n"]
[0.808, "o", "\r\n\u001b[2m# Three flags say who is answerable, what kind of claim it is, and\u001b[0m\r\n"]
[1.206, "o", "\r\n\u001b[2m# which licence governs reuse. --source says what it came from.\u001b[0m\r\n"]
[1.205, "o", "\u001b[32m$ node /Users/crtah/Data/3-plur/2-projects/plur/packages/cli/dist/index.js learn 'Connection pools cap at 100 on the shared tier' \\\r\n    --asserted-by local:maintainer \\\r\n    --claim-class documented \\\r\n    --source https://example.org/runbook \\\r\n    --license cc-by-4.0 \\\r\n    --visibility public \\\r\n    --path /var/folders/ky/ms6htv7j6sv5q43hw0gt0bbm0000gn/T/tmp.afmJpB3kks/store --json\u001b[0m\r\n"]
[0.680, "o", "{\"id\":\"ENG-2026-08-23-002\",\"statement\":\"Connection pools cap at 100 on the shared tier\",\"scope\":\"global\",\"type\":\"behavioral\",\"domain\":null}\r\n"]
[1.407, "o", "\r\n\u001b[2m# Ask again. Nothing is missing this time.\u001b[0m\r\n"]
[1.206, "o", "\u001b[32m$ node /Users/crtah/Data/3-plur/2-projects/plur/packages/cli/dist/index.js provenance 'connection pools' --path /var/folders/ky/ms6htv7j6sv5q43hw0gt0bbm0000gn/T/tmp.afmJpB3kks/store --json | python3 -m json.tool\u001b[0m\r\n"]
[0.675, "o", "{\r\n    \"found\": true,\r\n    \"engram_id\": \"ENG-2026-08-23-002\",\r\n    \"may_leave_this_machine\": true,\r\n    \"may_reuse_commercially\": true,\r\n    \"may_redistribute\": true,\r\n    \"licence_recognised\": true,\r\n    \"licence_chosen\": true,\r\n    \"scope\": \"global\",\r\n    \"visibility\": \"public\",\r\n    "]
[0.000, "o", "\"asserted_by\": \"local:maintainer\",\r\n    \"identity_stated\": true,\r\n    \"claim_class\": \"documented\",\r\n    \"claim_meaning\": \"taken from prose a human wrote\",\r\n    \"first_written\": \"2026-08-23T16:28:54.997Z\",\r\n    "]
[0.000, "o", "\"came_from\": {\r\n        \"value\": \"https://example.org/runbook\",\r\n        \"is_link\": true\r\n    },\r\n    "]
[0.000, "o", "\"licence\": {\r\n        "]
[0.000, "o", "\"name\": \"cc-by-4.0\",\r\n        "]
[0.000, "o", "\"chosen\": true,\r\n        \"meaning\": \"reuse allowed, credit required\"\r\n    },\r\n    \"recorded_steps\": 1,\r\n    \"not_recorded\": [],\r\n    "]
[0.000, "o", "\"complete\": true\r\n"]
[0.000, "o", "}\r\n"]
[1.408, "o", "\r\n\u001b[2m# Note the three machine-readable answers: may_reuse_commercially,\u001b[0m\r\n"]
[1.209, "o", "\r\n\u001b[2m# may_redistribute, licence_recognised. They fail CLOSED — an unknown\u001b[0m\r\n"]
[1.206, "o", "\r\n\u001b[2m# licence yields false, never null, because a consumer written\u001b[0m\r\n"]
[1.207, "o", "\r\n\u001b[2m# 'if (x !== false)' would read null as permission.\u001b[0m\r\n"]
[1.215, "o", "\r\n\u001b[1m\u001b[36m3. Sharing it: a pack carries provenance without being asked\u001b[0m\r\n──────────────────────────────────────────────────────────────\r\n"]
[0.809, "o", "\r\n\u001b[2m# A pack is how memories leave your machine, so this is where origin\u001b[0m\r\n"]
[1.208, "o", "\r\n\u001b[2m# starts to matter to somebody else. It ships by default.\u001b[0m\r\n"]
[1.204, "o", "\u001b[32m$ node /Users/crtah/Data/3-plur/2-projects/plur/packages/cli/dist/index.js packs export team-conventions --output /var/folders/ky/ms6htv7j6sv5q43hw0gt0bbm0000gn/T/tmp.afmJpB3kks/pack --path /var/folders/ky/ms6htv7j6sv5q43hw0gt0bbm0000gn/T/tmp.afmJpB3kks/store --json | python3 -m json.tool\u001b[0m\r\n"]
[0.678, "o", "{\r\n    \"path\": \"/var/folders/ky/ms6htv7j6sv5q43hw0gt0bbm0000gn/T/tmp.afmJpB3kks/pack\",\r\n    \"engram_count\": 1,\r\n    \"integrity\": \"sha256:ec552eb12abbbb37b1fbeeeedfb167b6a1dc82d344202bd4ea4b12ff6e01f5d9\",\r\n    \"match_terms\": [],\r\n    \"provenance_files\": [\r\n        \"provenance/pack.jsonld\",\r\n        \"provenance/ENG-2026-08-23-002.jsonld\"\r\n    "]
[0.000, "o", "],\r\n    \"privacy\": {\r\n        \"clean\": false,\r\n        "]
[0.000, "o", "\"issues\": [\r\n            {\r\n                \"engram_id\": \"ENG-2026-08-23-001\",\r\n                \"type\": \"private_visibility\",\r\n                \"detail\": \"Engram marked as private \\u2014 excluded from export, still scanned\"\r\n            }\r\n        "]
[0.000, "o", "]\r\n    "]
[0.000, "o", "},\r\n    "]
[0.000, "o", "\"name\": \"team-conventions\"\r\n}\r\n"]
[1.409, "o", "\r\n\u001b[2m# One record per engram, plus one for the pack as a whole.\u001b[0m\r\n"]
[1.210, "o", "\u001b[32m$ ls -1 /var/folders/ky/ms6htv7j6sv5q43hw0gt0bbm0000gn/T/tmp.afmJpB3kks/pack /var/folders/ky/ms6htv7j6sv5q43hw0gt0bbm0000gn/T/tmp.afmJpB3kks/pack/provenance\u001b[0m\r\n"]
[0.616, "o", "/var/folders/ky/ms6htv7j6sv5q43hw0gt0bbm0000gn/T/tmp.afmJpB3kks/pack:\r\n"]
[0.000, "o", "engrams.yaml\r\nINTEGRITY\r\nprovenance\r\nSKILL.md\r\n\r\n/var/folders/ky/ms6htv7j6sv5q43hw0gt0bbm0000gn/T/tmp.afmJpB3kks/pack/provenance:\r\n"]
[0.000, "o", "ENG-2026-08-23-002.jsonld\r\npack.jsonld\r\n"]
[1.416, "o", "\r\n\u001b[1m\u001b[36m4. Receiving it: what a recipient can check BEFORE installing\u001b[0m\r\n──────────────────────────────────────────────────────────────\r\n"]
[0.807, "o", "\r\n\u001b[2m# The gate belongs at the boundary. Afterwards it changes nothing.\u001b[0m\r\n"]
[1.209, "o", "\u001b[32m$ node /Users/crtah/Data/3-plur/2-projects/plur/packages/cli/dist/index.js packs preview /var/folders/ky/ms6htv7j6sv5q43hw0gt0bbm0000gn/T/tmp.afmJpB3kks/pack --path /var/folders/ky/ms6htv7j6sv5q43hw0gt0bbm0000gn/T/tmp.afmJpB3kks/recipient --json | python3 -c \"\r\nimport json,sys\r\nd = json.load(sys.stdin)\r\nprint('integrity :', d['integrity']['status'])\r\nprint('records   :', d['provenance']['record_count'], 'of', d['engram_count'], 'engrams')\r\nprint('asserted  :', d['provenance']['asserted_by'])\r\nprint('verified  :', d['provenance']['verified'])\r\nfor l in d['provenance']['licences']:\r\n    print('licence   :', l['name'], '- chosen by the author:', l['chosen'])\r\nprint()\r\nprint(d['provenance']['verification_note'])\r\n\"\u001b[0m\r\n"]
[0.675, "o", "integrity : ok\r\nrecords   : 1 of 1 engrams\r\nasserted  : ['local:maintainer']\r\nverified  : False\r\nlicence   : cc-by-4.0 - chosen by the author: True\r\n\r\nNothing here has been verified. Packs are not signed yet, so every statement below is what the pack says about itself. Treat it as a claim by whoever built the pack, and weigh it the way you weigh who gave you the pack.\r\n"]
[1.409, "o", "\r\n\u001b[2m# Read that last line twice. NOTHING here is signed, so everything the\u001b[0m\r\n"]
[1.204, "o", "\r\n\u001b[2m# pack says about itself is a claim by whoever built it. There is no\u001b[0m\r\n"]
[1.209, "o", "\r\n\u001b[2m# tick and no badge anywhere in this output, deliberately.\u001b[0m\r\n"]
[1.208, "o", "\r\n\u001b[2m# Tamper with the pack and the integrity check notices.\u001b[0m\r\n"]
[1.207, "o", "\u001b[32m$ sed -i '' 's/Connection pools/Connection pool/' /var/folders/ky/ms6htv7j6sv5q43hw0gt0bbm0000gn/T/tmp.afmJpB3kks/pack/engrams.yaml\u001b[0m\r\n"]
[2.022, "o", "\u001b[32m$ node /Users/crtah/Data/3-plur/2-projects/plur/packages/cli/dist/index.js packs install /var/folders/ky/ms6htv7j6sv5q43hw0gt0bbm0000gn/T/tmp.afmJpB3kks/pack --path /var/folders/ky/ms6htv7j6sv5q43hw0gt0bbm0000gn/T/tmp.afmJpB3kks/recipient --json | python3 -m json.tool\u001b[0m\r\n"]
[0.675, "o", "{\r\n    \"error\": \"This pack does not match the integrity value it shipped.\\n  shipped:  sha256:ec552eb12abbbb37b1fbeeeedfb167b6a1dc82d344202bd4ea4b12ff6e01f5d9\\n  contents: sha256:11e724c0919664378c85452ba929c72aef59f63e3b907763548dfcba45d3c319\\nIt has been changed since it was built. Install it only if you know why it differs.\"\r\n}\r\n"]
[1.409, "o", "\r\n\u001b[2m# Put it back, and it installs.\u001b[0m\r\n"]
[1.209, "o", "\u001b[32m$ sed -i '' 's/Connection pool /Connection pools /' /var/folders/ky/ms6htv7j6sv5q43hw0gt0bbm0000gn/T/tmp.afmJpB3kks/pack/engrams.yaml\u001b[0m\r\n"]
[2.019, "o", "\u001b[32m$ node /Users/crtah/Data/3-plur/2-projects/plur/packages/cli/dist/index.js packs install /var/folders/ky/ms6htv7j6sv5q43hw0gt0bbm0000gn/T/tmp.afmJpB3kks/pack --path /var/folders/ky/ms6htv7j6sv5q43hw0gt0bbm0000gn/T/tmp.afmJpB3kks/recipient --json | python3 -c \"\r\nimport json,sys\r\nd = json.load(sys.stdin)\r\nprint('installed :', d['installed'], 'engrams')\r\nprint('integrity :', d['integrity_check']['status'])\r\n\"\u001b[0m\r\n"]
[0.698, "o", "installed : 1 engrams\r\nintegrity : ok\r\n"]
[1.413, "o", "\r\n\u001b[1m\u001b[36m5. Correcting a memory\u001b[0m\r\n──────────────────────────────────────────────────────────────\r\n"]
[0.806, "o", "\r\n\u001b[2m# Record a correction that replaces the earlier one.\u001b[0m\r\n"]
[1.206, "o", "\u001b[32m$ node /Users/crtah/Data/3-plur/2-projects/plur/packages/cli/dist/index.js learn 'Connection pools cap at 200 on the shared tier since August' \\\r\n    --supersedes ENG-2026-08-23-002 \\\r\n    --asserted-by local:maintainer --claim-class documented \\\r\n    --path /var/folders/ky/ms6htv7j6sv5q43hw0gt0bbm0000gn/T/tmp.afmJpB3kks/store --json 2>/dev/null | head -1\u001b[0m\r\n"]
[0.681, "o", "{\"id\":\"ENG-2026-08-23-003\",\"statement\":\"Connection pools cap at 200 on the shared tier since August\",\"scope\":\"global\",\"type\":\"behavioral\",\"domain\":null}\r\n"]
[1.407, "o", "\r\n\u001b[2m# Now ask about the OLD memory. It says what replaced it, in the first\u001b[0m\r\n"]
[1.208, "o", "\r\n\u001b[2m# line, and is never reported complete.\u001b[0m\r\n"]
[1.208, "o", "\u001b[32m$ node /Users/crtah/Data/3-plur/2-projects/plur/packages/cli/dist/index.js provenance ENG-2026-08-23-002 --path /var/folders/ky/ms6htv7j6sv5q43hw0gt0bbm0000gn/T/tmp.afmJpB3kks/store --json | python3 -c \"\r\nimport json,sys\r\nd = json.load(sys.stdin)\r\nprint('superseded_by :', d.get('superseded_by'))\r\nprint('complete      :', d['complete'])\r\n\"\u001b[0m\r\n"]
[0.662, "o", "superseded_by : ['ENG-2026-08-23-003']\r\ncomplete      : False\r\n"]
[1.408, "o", "\r\n\u001b[2m# Provenance RECORDS the correction. What recall and injection do with\u001b[0m\r\n"]
[1.209, "o", "\r\n\u001b[2m# that is PLUR's decision, not provenance's — and it is unchanged.\u001b[0m\r\n"]
[1.209, "o", "\r\n\u001b[1m\u001b[36m6. The document itself, for machines\u001b[0m\r\n──────────────────────────────────────────────────────────────\r\n"]
[0.805, "o", "\r\n\u001b[2m# Everything above is a readable summary of this.\u001b[0m\r\n"]
[1.203, "o", "\u001b[32m$ node /Users/crtah/Data/3-plur/2-projects/plur/packages/cli/dist/index.js provenance ENG-2026-08-23-002 --record --path /var/folders/ky/ms6htv7j6sv5q43hw0gt0bbm0000gn/T/tmp.afmJpB3kks/store --json | python3 -c \"\r\nimport json,sys\r\nr = json.load(sys.stdin)['record']\r\nprint(json.dumps(r['@context'], indent=2))\r\nsub = [n for n in r['@graph'] if n.get('@id','').startswith('engram:ENG')][0]\r\nfor k in ('engram:claimClass','engram:license','engram:maySharePlainly',\r\n          'prov:wasAttributedTo','prov:hadPrimarySource','engram:supersededBy'):\r\n    if k in sub: print(f'{k:24}', json.dumps(sub[k]))\r\npol = sub.get('odrl:hasPolicy', {})\r\nprint('odrl permissions        ', json.dumps(pol.get('odrl:permission')))\r\nprint('odrl prohibitions       ', json.dumps(pol.get('odrl:prohibition')))\r\n\"\u001b[0m\r\n"]
[0.670, "o", "{\r\n  \"prov\": \"http://www.w3.org/ns/prov#\",\r\n  \"engram\": \"https://plur.ai/ns/engram#\",\r\n  \"pa\": \"https://w3id.org/prov-agent#\",\r\n  \"odrl\": \"http://www.w3.org/ns/odrl/2/\",\r\n  \"xsd\": \"http://www.w3.org/2001/XMLSchema#\"\r\n}\r\nengram:claimClass        \"documented\"\r\nengram:license           \"cc-by-4.0\"\r\n"]
[0.000, "o", "engram:maySharePlainly   true\r\nprov:wasAttributedTo     {\"@id\": \"engram:agent/local:maintainer\"}\r\n"]
[0.000, "o", "prov:hadPrimarySource    {\"@id\": \"https://example.org/runbook\"}\r\n"]
[0.000, "o", "engram:supersededBy      [{\"@id\": \"engram:ENG-2026-08-23-003\"}]\r\nodrl permissions         [{\"odrl:action\": [\"odrl:use\", \"odrl:reproduce\", \"odrl:distribute\", \"odrl:derive\"], \"odrl:duty\": [{\"odrl:action\": \"odrl:attribute\"}]}]\r\nodrl prohibitions        null\r\n"]
[1.409, "o", "\r\n\u001b[2m# Valid W3C PROV in JSON-LD, with licences expressed as ODRL policy.\u001b[0m\r\n"]
[1.205, "o", "\r\n\u001b[2m# Checked against two outside implementations, not only our own.\u001b[0m\r\n"]
[1.208, "o", "\r\n\u001b[1m\u001b[32mDone. The throwaway store is deleted on exit.\u001b[0m\r\n\r\n"]
[2.013, "x", "0"]
